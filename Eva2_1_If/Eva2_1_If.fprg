    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Edad" type="Integer" array="False" size=""/>
            <output expression="&quot;Cual es tu edad?: &quot;" newline="True"/>
            <input variable="Edad"/>
            <if expression="Edad &gt;= 18">
                <then>
                    <output expression="&quot;Eres mayor de edad, puedes entrar&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;No puedes entrar&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
